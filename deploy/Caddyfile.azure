# Caddyfile for Cogentrex Azure VM
# Temporary sslip.io hostname driven by COGENTREX_PUBLIC_IP env var.
# Replace with dev.cogentrex.com when GoDaddy DNS is configured.
#
# Usage: COGENTREX_PUBLIC_IP=x.x.x.x caddy run --config /etc/caddy/Caddyfile
#
# sslip.io provides automatic DNS-based TLS via Let's Encrypt.

{$COGENTREX_PUBLIC_IP:0.0.0.0}.sslip.io {
	# Reverse proxy to the Compose gateway (nginx) on port 8080
	reverse_proxy localhost:8080

	# Standard security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Health check passthrough (no TLS needed internally)
	handle /healthz {
		reverse_proxy localhost:8080
	}
	handle /readyz {
		reverse_proxy localhost:8080
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# HTTP redirect (Caddy does this automatically with HTTPS, but explicit)
http://{$COGENTREX_PUBLIC_IP:0.0.0.0}.sslip.io {
	redir https://{host}{uri} permanent
}
