ARCHON_LLM_PROVIDER=ollama
ARCHON_LLM_MODEL=llama3.1:8b
ARCHON_LLM_BASE_URL=http://localhost:11434
ARCHON_DATABASE_URL=sqlite+aiosqlite:///archon.db
# Required: canonical unpadded 43-character URL-safe Base64 for 32 random bytes; never commit it.
ARCHON_ENCRYPTION_MASTER_KEY=
# Set false only to disable the persistent-memory API and live memory tool completely.
ARCHON_MEMORY_ENCRYPTION_ENABLED=true
ARCHON_REDIS_URL=redis://localhost:6379/0
# Sliding-window limits. Per-category values default to ARCHON_RATE_LIMIT_REQUESTS.
ARCHON_RATE_LIMIT_REQUESTS=60
ARCHON_RATE_LIMIT_WINDOW=60
# ARCHON_RATE_LIMIT_AUTH_REQUESTS=60
# ARCHON_RATE_LIMIT_CHAT_REQUESTS=60
# ARCHON_RATE_LIMIT_TASK_REQUESTS=60
# ARCHON_RATE_LIMIT_MCP_REQUESTS=60
ARCHON_JWT_SECRET=change-me-in-production
ARCHON_DEBUG=true
ARCHON_SKILLS_TOP_K=3
ARCHON_IMAGE_GEN_PROVIDER=mock


# Untrusted execution is omitted from live tools unless explicitly enabled.
ARCHON_EXECUTION_ENABLED=false
ARCHON_EXECUTION_DOCKER_BINARY=docker
ARCHON_EXECUTION_DOCKER_IMAGE=archon-sandbox:local
ARCHON_EXECUTION_DOCKER_PLATFORM=linux/amd64
# Set true in production and configure IMAGE as name@sha256:<64 lowercase hex>.
ARCHON_EXECUTION_REQUIRE_IMAGE_DIGEST=false
ARCHON_EXECUTION_TIMEOUT_SECONDS=10
ARCHON_EXECUTION_CPUS=0.5
ARCHON_EXECUTION_MEMORY_MB=128
ARCHON_EXECUTION_PIDS_LIMIT=64
ARCHON_EXECUTION_OUTPUT_BYTES=65536
