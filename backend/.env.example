# Archon Configuration
# Copy to .env and fill in your values

# LLM Provider: mock | openai | anthropic | foundry | ollama
ARCHON_LLM_PROVIDER=mock
ARCHON_LLM_MODEL=mock-model
ARCHON_LLM_API_KEY=
ARCHON_LLM_BASE_URL=

# Database (Docker Compose default)
ARCHON_DATABASE_URL=postgresql+asyncpg://archon:archon_dev@localhost:5432/archon

# Redis (Docker Compose default)
ARCHON_REDIS_URL=redis://localhost:6379/0

# Security
ARCHON_SECRET_KEY=change-me-in-production
ARCHON_ENCRYPTION_MASTER_KEY=

# Agent
ARCHON_AGENT_MAX_ITERATIONS=5
ARCHON_AGENT_TOKEN_BUDGET=8000

# Rate Limiting
ARCHON_RATE_LIMIT_REQUESTS=60
ARCHON_RATE_LIMIT_WINDOW=60

