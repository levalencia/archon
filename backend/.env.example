ARCHON_LLM_PROVIDER=ollama
ARCHON_LLM_MODEL=llama3.1:8b
ARCHON_LLM_BASE_URL=http://localhost:11434
ARCHON_DATABASE_URL=sqlite+aiosqlite:///archon.db
# Required by default. Generate a unique 256-bit URL-safe base64 token (see README); never commit it.
ARCHON_ENCRYPTION_MASTER_KEY=
# Set false only to disable the persistent-memory API and live memory tool completely.
ARCHON_MEMORY_ENCRYPTION_ENABLED=true
ARCHON_REDIS_URL=redis://localhost:6379/0
ARCHON_JWT_SECRET=change-me-in-production
ARCHON_DEBUG=true
ARCHON_SKILLS_TOP_K=3
ARCHON_IMAGE_GEN_PROVIDER=mock
