{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "archon.learning.deck"
    },
    "version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "message",
          "visual",
          "notes",
          "presenter_script",
          "key_terms",
          "common_misconception",
          "transition",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "presenter_script": {
            "type": "string",
            "minLength": 300
          },
          "key_terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "definition"],
              "properties": {
                "term": {"type": "string", "minLength": 1},
                "definition": {"type": "string", "minLength": 1}
              }
            }
          },
          "common_misconception": {"type": "string", "minLength": 1},
          "transition": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "version",
    "artifact_id",
    "pack_id",
    "title",
    "language",
    "source_commit",
    "limitations",
    "sources",
    "slides"
  ]
}
