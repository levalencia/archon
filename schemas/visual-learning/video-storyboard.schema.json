{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cogentrex.learning.video-storyboard"
    },
    "version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "width": {
      "const": 1920
    },
    "height": {
      "const": 1080
    },
    "fps": {
      "const": 30
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_seconds",
          "narration",
          "visual",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "narration": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "version",
    "artifact_id",
    "pack_id",
    "title",
    "language",
    "source_commit",
    "limitations",
    "sources",
    "width",
    "height",
    "fps",
    "scenes"
  ]
}
