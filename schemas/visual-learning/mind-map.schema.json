{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "archon.learning.mind-map"
    },
    "version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "summary", "details", "sources", "children"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "summary": {"type": "string"},
              "details": {"type": "string"},
              "sources": {"type": "array", "items": {"type": "string"}},
              "children": {"type": "array", "items": {"type": "object"}}
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "version",
    "artifact_id",
    "pack_id",
    "title",
    "language",
    "source_commit",
    "limitations",
    "sources",
    "root"
  ]
}
