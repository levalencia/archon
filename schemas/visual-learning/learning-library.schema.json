{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cogentrex.learning-library"
    },
    "version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "title",
                "status",
                "language",
                "file",
                "media_type",
                "sha256",
                "source_commit",
                "limitations"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "review-ready",
                    "published",
                    "stale"
                  ]
                },
                "language": {
                  "const": "en"
                },
                "file": {
                  "type": "string"
                },
                "media_type": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "limitations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "content_file": {
                  "type": "string",
                  "minLength": 1
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "allOf": [
                {
                  "if": {"required": ["content_file"]},
                  "then": {"required": ["content_sha256"]}
                },
                {
                  "if": {"required": ["content_sha256"]},
                  "then": {"required": ["content_file"]}
                }
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "version",
    "generated_at",
    "source_commit",
    "packs"
  ]
}
